  "scripts": {
    "dev": "nodemon --watch server --ext ts --exec \"tsx server/index.ts\"",
    "prebuild": "tsx server/scripts/ensure-db.ts",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
