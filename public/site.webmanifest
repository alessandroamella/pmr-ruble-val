{
  "$schema": "https://www.schemastore.org/web-manifest-combined.json",
  "name": "PMR Ruble Value",
  "short_name": "PMR Ruble",
  "categories": ["finance", "utilities", "productivity"],
  "description": "An application that provides up-to-date exchange rates and historical data for the Transnistrian Ruble (PMR) against major currencies like USD and EUR.",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone"
}
